    "token-savings",
    "anthropic",
    "ai-agents"
  ],
  "homepage": "https://github.com/DarkStar616/rewind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarkStar616/rewind.git",
    "directory": "packages/gateway"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
