{
  "name": "rewind-monorepo",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "test": "NODE_OPTIONS=--conditions=development node --test packages/*/test/*.test.ts",
    "check": "npm run typecheck && npm run test",
    "build": "npm run build --workspaces --if-present",
    "clean": "rm -rf packages/*/dist"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
